# Copy to .env and fill in.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg://wcm:wcm@localhost:5432/wcm

# Wikimedia requires a descriptive User-Agent with contact info:
# https://meta.wikimedia.org/wiki/User-Agent_policy
WCM_CONTACT=you@example.org

# Reviewer accounts for the web UI, as name:token pairs (comma-separated).
WCM_REVIEWER_TOKENS=alice:change-me-1,bob:change-me-2

# Optional overrides
# WCM_JUDGE_MODEL=claude-opus-5-5
# WCM_JUDGE_EFFORT=high
# WCM_MAX_SOURCE_CHARS=400000
